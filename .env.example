# Copy to .env only if your launcher explicitly loads it. Never commit .env.
# For non-loopback access, set MCP_BEARER to a generated secret in the process
# environment and configure the client to read that environment variable.
# MCP_BEARER=
ALLOWED_ORIGINS=http://127.0.0.1:8000
FRAM_DEV_PROFILE=0
# Keep runtime writes outside the tracked checkout. Launchers derive this path.
# FRAM_STORAGE_ROOT=
FRAM_WORKING_MEMORY_DEDUPE_WINDOW_SEC=2
FRAM_LIVED_MEMORY_ENABLED=1
FRAM_LIVED_MEMORY_TARGET_DIM=12
FRAM_LIVED_MEMORY_FRACTAL_NODES=64
FRAM_LIVED_MEMORY_RECALL_K=4
FRAM_LIVED_MEMORY_SCAN_LIMIT=5000
FRAM_LIVED_MEMORY_STATE_DECAY=0.82
FRAM_LIVED_MEMORY_BUSY_TIMEOUT_SECONDS=5
FRAM_CONTINUITY_WITNESS_ENABLED=0
FRAM_CONTINUITY_WITNESS_MAX_AGE_SECONDS=3600
FRAM_CONTINUITY_WITNESS_LOCK_TIMEOUT_SECONDS=0.1
COGMEM_AUTOLOG=0
COGMEM_SESSION_ID=dev
